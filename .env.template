PORT=3000
DATABASE_URL=postgres://user:password@localhost:5432/clinica
REDIS_URL=redis://localhost:6379
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=1d
DISCORD_WEBHOOK_URL=
GITHUB_WEBHOOK_SECRET=
LOG_LEVEL=info
# Opcional. Origen(es) permitidos para CORS separados por coma (ej. http://localhost:5173).
# Default '*' si se omite: refleja cualquier origen (seguro aca, la API usa Bearer tokens, no cookies).
CORS_ORIGIN=*
# Opcional. Notifica por email al paciente cuando su cita se cancela. Vacio = no-op.
# EMAIL_USER es la cuenta que envia (ej. un Gmail), EMAIL_PASSWORD una contrasena de
# aplicacion (nunca la contrasena normal de la cuenta). Sin EMAIL_HOST se usa Gmail SMTP.
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM_NAME=Clinica
EMAIL_HOST=
EMAIL_PORT=
# Opcional. Foto de perfil de medicos/pacientes (una sola por usuario, se sirve en /uploads).
# UPLOAD_DIR es relativo a la raiz del proyecto. Default: uploads / 2 (MB).
UPLOAD_DIR=uploads
MAX_PHOTO_SIZE_MB=2
# Opcional. Object storage para las fotos (Cloudflare R2) -- si las 5 estan presentes, se usa
# en vez del disco local (necesario en hosts de disco efimero, ej. Render). Vacio = disco local.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
